<%# Footer with dynamic copyright year. The year is calculated at render time,
    so it automatically updates each January 1st without a code change. %>
<footer class="mx-auto w-full max-w-3xl px-5 pt-4 pb-8 sm:pb-10 text-center">
  <p class="text-body text-ink-muted">© <%= Date.current.year %></p>
</footer>
