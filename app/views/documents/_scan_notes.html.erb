<%# D1 and D2: links and attachments never block a document, but they are not
    hidden either. Every genuine document has links; the reader is the one who
    can judge whether these look right. %>
<% if document.links.any? || document.attachments.any? %>
  <section class="border-2 border-rule rounded-lg p-5 mb-8">
    <h2 class="text-lead font-bold mb-3">What's inside this document</h2>

    <% if document.attachments.any? %>
      <p class="text-body mb-2">
        It carries <%= pluralize(document.attachments.length, "attached file") %>:
        <%= document.attachments.to_sentence %>.
      </p>
    <% end %>

    <% if document.links.any? %>
      <p class="text-body mb-2">
        It contains <%= pluralize(document.links.length, "link") %> to other places:
      </p>
      <ul class="text-body list-disc pl-6">
        <% document.links.first(20).each do |link| %>
          <%# Shown as text, never as a clickable link: this document came from
              somewhere we have not decided to trust. %>
          <li class="break-all"><%= link %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
