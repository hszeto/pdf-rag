<%# Interim view for this checkpoint: the document is stored and being read.
    The summary and chat arrive with retrieval. %>
<h1 class="text-title font-bold mb-4"><%= @document.title %></h1>

<% if @document.processing? %>
  <p class="text-lead mb-8">Reading your document…</p>
  <p class="text-body text-ink-muted mb-8">
    <%= pluralize(@document.chunks.count, "passage") %> found so far.
  </p>
<% elsif @document.failed? %>
  <%= render "documents/error", message: @document.failure_reason %>
<% else %>
  <p class="text-lead mb-8">
    Ready — <%= pluralize(@document.chunks.count, "passage") %>.
  </p>
<% end %>

<%= render "documents/scan_notes", document: @document %>

<p class="text-body text-ink-muted">
  This document is removed automatically at
  <%= @document.expires_at.strftime("%-l:%M %p") %>.
</p>
