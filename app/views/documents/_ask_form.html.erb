<%= form_with url: document_messages_path(document), method: :post, id: "ask-form" do |form| %>
  <%# The prompt shows as a placeholder, but the label stays for anyone who
      cannot see it. A placeholder is not a label: it disappears at the first
      keystroke, and screen readers treat it inconsistently. Hidden visually,
      announced all the same (R2.5, AC11). %>
  <%= form.label :question, "Type your question", class: "sr-only" %>

  <%# The button sits inside the field's bounds. pr-28 reserves the room it
      occupies so a long question never slides underneath it. %>
  <div class="relative">
    <%= form.text_field :question, required: true, autocomplete: "off",
          placeholder: "Type your question",
          class: "block w-full text-lead border-2 border-rule rounded-full py-4 pl-5 pr-28 placeholder:text-ink-muted" %>

    <%# Answering takes a few seconds — an embedding call and a generation
        call. Turbo swaps this label for the duration, so the wait is visible
        without any JavaScript of ours. text-body, not smaller: nothing on this
        screen may fall below 18px, and a system test asserts it. %>
    <%= form.submit "Ask", data: { turbo_submits_with: "Thinking…" },
          class: "absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-accent text-accent-ink px-6 py-2 text-body font-bold cursor-pointer" %>
  </div>
<% end %>
