<%# The plan screen. One fact per row, in the order the spec fixes (R7.3), with
    the numbers people actually came for set larger than everything else. %>
<% session = current_insurance_session %>

<h1 class="text-title font-bold mb-3">Your plan</h1>

<% if session.document_type.present? %>
  <p class="text-lead text-ink-muted mb-8"><%= session.document_type %></p>
<% end %>

<dl class="mb-10">
  <% PlanPresenter::ROWS.each do |key, label, emphasis| %>
    <div class="border-b border-rule py-5 sm:flex sm:items-baseline sm:gap-6">
      <dt class="text-body text-ink-muted sm:w-2/5"><%= label %></dt>
      <dd class="sm:w-3/5 <%= emphasis == :fact ? "text-fact font-bold" : "text-lead" %>">
        <% if (value = session.field(key)).present? %>
          <%= value %>
        <% else %>
          <%# Said out loud rather than left blank, so a missing fact never reads
              as a fact we forgot to show (R7.3). %>
          <span class="text-body text-ink-muted italic">Not found in your document</span>
        <% end %>
      </dd>
    </div>
  <% end %>
</dl>

<section class="mb-10">
  <h2 class="text-lead font-bold mb-3">In plain words</h2>
  <p class="text-body"><%= session.plain_summary %></p>
</section>

<%= render "sessions/grounding_note" %>

<%= button_to "Remove my document", session_path, method: :delete,
      class: "rounded-lg border-2 border-accent text-accent px-6 py-4 text-lead font-bold" %>
