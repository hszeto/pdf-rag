<%# Adding another document replaces the one held (R3.1). This is also what
    gives an upload refusal somewhere to retry from when a document is already
    on screen — without it, that refusal would be a dead end (R7.5). %>
<details class="mb-10">
  <summary class="text-body text-accent cursor-pointer py-2">Add a different document</summary>

  <%= form_with url: document_path, method: :post, class: "mt-4" do |form| %>
    <%= form.file_field :document, accept: "application/pdf", required: true,
          class: "block w-full text-body border-2 border-rule rounded-lg p-4 mb-4" %>
    <%= form.submit "Read this one instead",
          class: "rounded-lg border-2 border-accent text-accent px-6 py-3 text-body font-bold cursor-pointer" %>
  <% end %>
</details>
