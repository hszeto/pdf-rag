<%# No mention of "AI", "upload", "session" or other technical words (R7.1). %>
<h1 class="text-3xl font-bold mb-4">Understand your insurance</h1>

<p class="text-lg mb-6">
  We'll look at it and explain what it means.
  Your document is deleted automatically after you're done.
</p>

<%= form_with url: document_path, method: :post, class: "mb-4" do |form| %>
  <%= form.label :document, "Add Your Insurance Document", class: "block text-lg mb-2" %>
  <%= form.file_field :document, accept: "application/pdf", required: true,
        class: "block mb-4 text-lg" %>
  <%= form.submit "Read my document", class: "rounded border px-6 py-3 text-lg" %>
<% end %>
