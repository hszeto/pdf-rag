<%# No mention of "AI", "upload", "session" or other technical words (R7.1). %>
<h1 class="text-title font-bold mb-4">Understand your insurance</h1>

<p class="text-lead mb-10">
  Add your insurance document and we'll explain what it means, in plain words.
</p>

<%= form_with url: document_path, method: :post, class: "mb-8" do |form| %>
  <%= form.label :document, "Add Your Insurance Document",
        class: "block text-lead font-bold mb-4" %>

  <%= form.file_field :document, accept: "application/pdf", required: true,
        class: "block w-full text-body border-2 border-rule rounded-lg p-4 mb-6" %>

  <%= form.submit "Read my document",
        class: "w-full sm:w-auto rounded-lg bg-accent text-accent-ink px-8 py-4 text-lead font-bold cursor-pointer" %>
<% end %>

<p class="text-body text-ink-muted">
  Your document is removed automatically after five minutes, so your
  information doesn't stay on this screen.
</p>
