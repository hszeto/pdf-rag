<%# Interim screen for this checkpoint: the document has been read and understood,
    but the large-type plan card is a later checkpoint. %>
<% session = current_insurance_session %>

<h1 class="text-3xl font-bold mb-4">Your plan</h1>

<% if session.document_type.present? %>
  <p class="text-lg mb-4"><%= session.document_type %></p>
<% end %>

<dl class="mb-6">
  <% InsuranceSession::FIELD_KEYS.each do |key| %>
    <div class="flex gap-4 py-2 border-b">
      <dt class="text-lg w-1/2"><%= key.to_s.humanize %></dt>
      <dd class="text-lg w-1/2">
        <%# A field the document did not contain is said out loud rather than
            left blank, so it never looks like we simply failed to show it. %>
        <%= session.field(key) || "Not found in your document" %>
      </dd>
    </div>
  <% end %>
</dl>

<h2 class="text-2xl font-bold mb-2">In plain words</h2>
<p class="text-lg mb-6"><%= session.plain_summary %></p>

<%= button_to "Remove my document", session_path, method: :delete,
      class: "rounded border px-6 py-3 text-lg" %>
