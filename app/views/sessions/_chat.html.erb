<%# R7.4. No "typing…" indicator or other chat-app affectation: this is meant to
    feel like asking a question, not like using a messaging product. %>
<% session = current_insurance_session %>

<section aria-labelledby="chat-heading" class="mb-10">
  <h2 id="chat-heading" class="text-lead font-bold mb-5">
    What would you like to know about your plan?
  </h2>

  <% if session.chat_history.any? %>
    <ol class="mb-8 space-y-5 list-none">
      <% session.chat_history.each do |turn| %>
        <% asked = turn[:role].to_s == "user" %>
        <li class="<%= asked ? "sm:ml-12" : "sm:mr-12" %>">
          <p class="text-body text-ink-muted mb-1">
            <%= asked ? "You asked" : "Answer" %>
          </p>
          <div class="rounded-lg p-5 text-lead <%= asked ? "bg-notice-bg text-notice-ink" : "border-2 border-rule" %>">
            <%= turn[:content] %>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>

  <%= form_with url: messages_path, method: :post, class: "mb-6" do |form| %>
    <%= form.label :question, "Type your question", class: "block text-body mb-2" %>
    <%= form.text_field :question, required: true, autocomplete: "off",
          class: "block w-full text-lead border-2 border-rule rounded-lg p-4 mb-4" %>
    <%= form.submit "Ask",
          class: "w-full sm:w-auto rounded-lg bg-accent text-accent-ink px-8 py-4 text-lead font-bold cursor-pointer" %>
  <% end %>

  <%# Open-ended chat is unfamiliar to a lot of people. These are here to show
      what kind of thing can be asked, not to be clever. %>
  <% if session.chat_history.empty? %>
    <p class="text-body text-ink-muted mb-3">Or ask one of these:</p>
    <ul class="space-y-3 list-none">
      <% [ "What's my copay for a doctor visit?",
           "What's my deductible?",
           "Is my medication covered?",
           "Who do I call with questions?" ].each do |example| %>
        <li>
          <%= button_to example, messages_path, params: { question: example },
                class: "w-full text-left rounded-lg border-2 border-accent text-accent px-5 py-4 text-body" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
