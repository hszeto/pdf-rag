<%# Which screen shows is driven by session status. Partials are named with
    their full path because this template is also rendered from other
    controllers, and a bare name would be looked up against that controller's
    view directory.

    An error never changes which screen renders. A refused document while one is
    already held must not throw the reader back to the landing page and lose
    their plan, and a question that failed must not either — both keep their
    place and show the message where it happened (R7.5). %>
<div class="w-full">
  <% if (message = flash[:alert].presence || current_insurance_session&.error_message.presence) %>
    <%= render "sessions/error", message: message %>
  <% end %>

  <% if session_expired? %>
    <%= render "sessions/removed_notice" %>
  <% end %>

  <% if current_insurance_session&.analyzing? %>
    <%= render "sessions/processing" %>
  <% elsif current_insurance_session&.extracted? %>
    <%= render "sessions/plan" %>
  <% else %>
    <%= render "sessions/landing" %>
  <% end %>
</div>
